{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Driveleaf",
  "version": "0.1.0",
  "identifier": "dev.driveleaf.desktop",
  "mainBinaryName": "driveleaf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Driveleaf",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "label": "main",
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "The Driveleaf Authors",
    "copyright": "Copyright (c) 2026 The Driveleaf Authors. MIT OR Apache-2.0.",
    "category": "Utility",
    "shortDescription": "Fast disk space analyzer for Windows",
    "longDescription": "Driveleaf reads the NTFS Master File Table directly and shows what fills your disk as a treemap.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
